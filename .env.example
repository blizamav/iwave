# Copiar a .env; nunca versionar credenciales. Node >=24.
PORT=3000
CONTACT_BIND=0.0.0.0
CONTACT_DB_PATH=/data/contact.sqlite
# En pruebas: origen real del sitio de pruebas (sin / final).
CONTACT_ALLOWED_ORIGINS=http://localhost:8127
TURNSTILE_HOSTNAMES=localhost
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Zoho: sin dominio de envío adicional. Verificar cada configuración antes de activar.
# verify-smtp.mjs valida solo el transporte: no requiere Turnstile, hash ni SQLite.
CONTACT_MAIL_PROVIDER=zoho
CONTACT_FROM=contacto@iwave.cl
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=contacto@iwave.cl
# Contraseña de aplicación privada; no pegar en chat ni pasar como argumento.
ZOHO_SMTP_PASSWORD=
# Alternativa explícita: CONTACT_MAIL_PROVIDER=resend y
# CONTACT_FROM=formulario@notificaciones.iwave.cl (requiere dominio verificado).
RESEND_API_KEY=
CONTACT_TO=contacto@iwave.cl
# Generar un valor aleatorio privado estable, >=32 caracteres. No rotar entre reinicios.
CONTACT_HASH_SECRET=
# Vacío: ignorar todas las cabeceras IP y limitar por conexión directa.
# Rellenar solo con IPs exactas del proxy conectado a la API, sin CIDR.
CONTACT_TRUSTED_PROXY_IPS=
CONTACT_RATE_MAX=5
CONTACT_RATE_WINDOW_SECONDS=600
CONTACT_DAILY_MAX=80
CONTACT_MONTHLY_MAX=2400
CONTACT_UPSTREAM_TIMEOUT_MS=10000

# Solo plantilla NPM: red externa existente del entorno de pruebas.
CONTACT_PROXY_NETWORK=
