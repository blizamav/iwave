--- a/Dockerfile
+++ b/Dockerfile
@@ -8,5 +8,6 @@
 COPY styles.css /usr/share/nginx/html/styles.css
 COPY script.js /usr/share/nginx/html/script.js
 COPY img /usr/share/nginx/html/img
+COPY robots.txt sitemap.xml favicon.ico /usr/share/nginx/html/

