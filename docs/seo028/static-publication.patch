--- a/.dockerignore
+++ b/.dockerignore
@@ -6,3 +6,6 @@
 !script.js
 !img/
 !img/**
+!robots.txt
+!sitemap.xml
+!favicon.ico
--- a/nginx.conf
+++ b/nginx.conf
@@ -19,6 +19,16 @@
         try_files /index.html =404;
     }

+    location = /robots.txt {
+        default_type text/plain;
+        try_files $uri =404;
+    }
+
+    location = /sitemap.xml {
+        default_type application/xml;
+        try_files $uri =404;
+    }
+
     location = /index.html {
         try_files $uri =404;
     }
